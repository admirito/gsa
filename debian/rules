#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

.PHONY: override_dh_auto_configure override_dh_installchangelogs override_dh_auto_install

override_dh_auto_clean:
	rm -rf build
	rm -rf node_modules
	dh_auto_clean

override_dh_auto_configure:
#	# extract-yarn-offline-cache uses "yarnpkg cache dir" which in
#	# ubuntu PPA will be executed with sbuild user (uid=2001) and
#	# the cache dir will be "/tmp/.yarn-cache-2001/v6" which will
#	# be different from the cache for "yarnpkg --offline" which is
#	# "/tmp/.yarn-cache-0/v6". Using fakeroot (uid=0) this problem
#	# whill be solved in launchpad.
	fakeroot extract-yarn-offline-cache || true

override_dh_auto_install:
	yarnpkg --offline
	NODE_OPTIONS=--openssl-legacy-provider yarnpkg --offline build
	mkdir -p debian/gsa/usr/share/gvm/gsad/
	rm -rf debian/gsa/usr/share/gvm/gsad/web
	mv build debian/gsa/usr/share/gvm/gsad/web
	dh_auto_install

override_dh_installchangelogs:
	dh_installchangelogs -k CHANGELOG.md

%:
	dh $@
