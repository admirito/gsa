#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

.PHONY: override_dh_auto_configure override_dh_installchangelogs override_dh_auto_install

override_dh_auto_clean:
	rm -rf build
	rm -rf node_modules
	dh_auto_clean

override_dh_auto_configure:
	extract-yarn-offline-cache || true

override_dh_auto_install:
	yarnpkg --offline
	yarnpkg --offline build
	mkdir -p debian/gsa/usr/share/gvm/gsad/
	rm -rf debian/gsa/usr/share/gvm/gsad/web
	mv build debian/gsa/usr/share/gvm/gsad/web
	dh_auto_install

override_dh_installchangelogs:
	dh_installchangelogs -k CHANGELOG.md

%:
	dh $@
